# Azure AI Workshop Environment Configuration
# Copy this file to .env and fill in the values below.

##############################################################################
# Azure AI Foundry Configuration
##############################################################################
FOUNDRY_ENDPOINT=https://<foundry_name>.cognitiveservices.azure.com/
AZURE_AI_PROJECT_ENDPOINT=https://<foundry_name>.services.ai.azure.com/api/projects/<project_name>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_AI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small

# API Key (fallback authentication - leave empty to use managed identity)
# AZURE_AI_FOUNDRY_KEY=<retrieve-manually-if-needed>

##############################################################################
# Azure AI Search Configuration
##############################################################################
AZURE_SEARCH_ENDPOINT=https://<search_service_name>.search.windows.net

# API Key (fallback authentication - leave empty to use managed identity)
AZURE_SEARCH_API_KEY=<your-search-api-key>

# Default index name (created by LAB_0_setup scripts)
AZURE_SEARCH_INDEX_NAME=health-insurance-benefits-index

# Knowledge base names for LAB_2 (created by indexing scripts)
AZURE_SEARCH_KNOWLEDGE_BASE_NAME=my-kb-low

##############################################################################
# Azure API Management (APIM) - MCP Server Configuration
##############################################################################
MCP_SERVER_URL=https://<apim_service_name>.azure-api.net/<api-path>/mcp
MCP_API_KEY=<your-apim-subscription-key>
APIM_GATEWAY_URL=https://<apim_service_name>.azure-api.net

##############################################################################
# Azure Application Insights (LAB_5 Observability)
##############################################################################
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<key>;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/
APPLICATIONINSIGHTS_INSTRUMENTATION_KEY=<instrumentation-key-guid>

##############################################################################
# Azure Resource Information
##############################################################################
AZURE_SUBSCRIPTION_ID=<your-subscription-id-guid>
AZURE_RESOURCE_GROUP=<your-resource-group-name>
AZURE_AI_FOUNDRY_NAME=<foundry_name>
AZURE_SEARCH_SERVICE_NAME=<search_service_name>
AZURE_APIM_SERVICE_NAME=<apim_service_name>

##############################################################################
# Authentication Configuration
##############################################################################
# By default, all services use Azure DefaultAzureCredential (Managed Identity)
# API keys are provided as fallback option if needed
# To use managed identity exclusively, ensure you're logged in with:
#   az login
# Or set environment variable for service principal:
#   AZURE_CLIENT_ID=<service-principal-client-id>
#   AZURE_TENANT_ID=<your-tenant-id>
#   AZURE_CLIENT_SECRET=<service-principal-secret>
