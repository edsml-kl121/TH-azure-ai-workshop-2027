                "value": "[if(not(empty(parameters('mcpBackendUrl'))), '<policies>\n  <inbound>\n    <base />\n    <set-backend-service backend-id=\"mcp-backend\" />\n    <set-header name=\"Ocp-Apim-Subscription-Key\" exists-action=\"delete\" />\n  </inbound>\n  <backend>\n    <base />\n  </backend>\n  <outbound>\n    <base />\n  </outbound>\n  <on-error>\n    <base />\n  </on-error>\n</policies>\n', '<policies>\n  <inbound>\n    <base />\n    <return-response>\n      <set-status code=\"503\" reason=\"Service Unavailable\" />\n      <set-body>Backend not configured. Please update APIM policy with Container App URL.</set-body>\n    </return-response>\n  </inbound>\n</policies>\n')]",
                "format": "xml"
              },
              "dependsOn": [
                "mcpApi"
              ]
            },
            "mcpSubscription": {
              "type": "Microsoft.ApiManagement/service/subscriptions",
              "apiVersion": "2023-09-01-preview",
              "name": "[format('{0}/{1}', parameters('apimServiceName'), 'mcp-subscription')]",
              "properties": {
                "displayName": "MCP Subscription",
                "scope": "[format('/apis/{0}', resourceId('Microsoft.ApiManagement/service/apis', parameters('apimServiceName'), 'mcp-api'))]",
                "state": "active"
              },
              "dependsOn": [
                "apimService",
                "mcpApi"
              ]
            }
          },
          "outputs": {
            "apimServiceId": {
              "type": "string",
              "value": "[resourceId('Microsoft.ApiManagement/service', parameters('apimServiceName'))]"
            },
            "apimServiceName": {
              "type": "string",
              "value": "[parameters('apimServiceName')]"
            },
            "apimGatewayUrl": {
              "type": "string",
              "value": "[reference('apimService').gatewayUrl]"
            },
            "mcpServerUrl": {
              "type": "string",
              "value": "[format('{0}/api-mcp/mcp', reference('apimService').gatewayUrl)]"
            },
            "apimPrincipalId": {
              "type": "string",
              "value": "[reference('apimService', '2023-09-01-preview', 'full').identity.principalId]"
            },
            "mcpSubscriptionKey": {
              "type": "securestring",
              "metadata": {
                "description": "MCP API Subscription Key (secure)"
              },
              "value": "[listSecrets('mcpSubscription', '2023-09-01-preview').primaryKey]"
            }
          }
        }
      }
    }
  },
